{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/table/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/user/(.*)",
      "dest": "frontend/user/$1"
    },
    {
      "src": "/shared/(.*)",
      "dest": "frontend/shared/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "frontend/admin/$1"
    },
    {
      "src": "/",
      "dest": "/user/pages/index.html",
      "status": 307
    },
    {
      "src": "/admin",
      "dest": "/admin/pages/login.html",
      "status": 307
    }
  ]
}
