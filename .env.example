NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:4000
TRUST_PROXY=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qr_ordering
DB_USER=root
DB_PASSWORD=replace-with-your-database-password
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace-this-with-a-long-random-string
ADMIN_COOKIE_NAME=qr_ordering_admin
ADMIN_COOKIE_DOMAIN=
ADMIN_COOKIE_SAME_SITE=Lax
ADMIN_COOKIE_SECURE=
ADMIN_TOKEN_EXPIRES_IN_SECONDS=43200
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
UPLOAD_STORAGE_MODE=local
MAX_UPLOAD_IMAGE_BYTES=2097152
ENABLE_REQUEST_LOGS=true
LOG_HEALTHCHECK_REQUESTS=false

# Contoh production:
# NODE_ENV=production
# FRONTEND_ORIGIN=https://your-domain.com
# TRUST_PROXY=1
# ADMIN_COOKIE_SECURE=true
# UPLOAD_STORAGE_MODE=external-url
